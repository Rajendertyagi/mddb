+++ b/services/mddbd/embedding_config.go
@@ -416,6 +416,8 @@ func (s *Server) InitializeEmbeddingFromConfig(config *EmbeddingConfig) {
 		emb = embedding.NewCohereProvider(config.APIKey, config.APIURL, config.Model, config.Dimensions)
 	case "voyage":
 		emb = embedding.NewVoyageProvider(config.APIKey, config.APIURL, config.Model, config.Dimensions)
+	case "offline":
+		emb = embedding.NewOfflineProvider(config.Model, config.Dimensions)
 	default:
 		return
 	}
diff --git a/services/mddbd/internal/embedding/embedding.go b/services/mddbd/internal/embedding/embedding.go
index 9ec8e26..cd57ff8 100644
--- a/services/mddbd/internal/embedding/embedding.go
+++ b/services/mddbd/internal/embedding/embedding.go
@@ -70,6 +70,14 @@ func NewProvider() Provider {
 		dims := envconf.Int("MDDB_EMBEDDING_DIMENSIONS", 1024)
 		return NewCohereProvider(apiKey, apiURL, model, dims)
 
+	case "offline":
+		// Deterministic, network-free embedder for CI/offline runs. Vectors are
+		// semantically neutral but let the full embed->index->search pipeline run
+		// without an external model or GPU.
+		model := envconf.String("MDDB_EMBEDDING_MODEL", "offline-hash-v1")
+		dims := envconf.Int("MDDB_EMBEDDING_DIMENSIONS", 256)
+		return NewOfflineProvider(model, dims)
+
 	default:
 		log.Printf("WARNING: unknown MDDB_EMBEDDING_PROVIDER=%q, embedding disabled", provider) // #nosec G706 -- internal log
 		return nil
diff --git a/services/mddbd/internal/embedding/embedding_extra_test.go b/services/mddbd/internal/embedding/embedding_extra_test.go
index d8b8de4..5b329e1 100644
--- a/services/mddbd/internal/embedding/embedding_extra_test.go
+++ b/services/mddbd/internal/embedding/embedding_extra_test.go
@@ -1,6 +1,8 @@
 package embedding
 
 import (
+	"context"
+	"math"
 	"mddb/internal/envconf"
 	"os"
 	"testing"
@@ -189,3 +191,46 @@ func TestEnvDefaultInt_Invalid(t *testing.T) {
 		t.Errorf("got %d, want 200 (fallback for invalid)", v)
 	}
 }
+
+func TestNewEmbeddingProvider_Offline(t *testing.T) {
+	t.Setenv("MDDB_EMBEDDING_PROVIDER", "offline")
+	_ = os.Unsetenv("MDDB_EMBEDDING_MODEL")
+	_ = os.Unsetenv("MDDB_EMBEDDING_DIMENSIONS")
+	p := NewProvider()
+	if p == nil {
+		t.Fatal("expected non-nil provider for offline")
+	}
+	if p.Model() != "offline-hash-v1" {
+		t.Errorf("Model = %q, want offline-hash-v1", p.Model())
+	}
+	if p.Dimensions() != 256 {
+		t.Errorf("Dimensions = %d, want 256", p.Dimensions())
+	}
+	// determinism: identical text -> identical vector
+	v1, err1 := p.Embed(context.Background(), "the quick brown fox")
+	if err1 != nil {
+		t.Fatalf("Embed returned error: %v", err1)
+	}
+	v2, _ := p.Embed(context.Background(), "the quick brown fox")
+	if len(v1) != 256 {
+		t.Fatalf("expected dim 256, got %d", len(v1))
+	}
+	for i := range v1 {
+		if v1[i] != v2[i] {
+			t.Fatalf("offline embedding not deterministic at dim %d", i)
+		}
+	}
+	// distinct texts should (with overwhelming probability) yield distinct vectors
+	v3, _ := p.Embed(context.Background(), "a completely different sentence")
+	if v3[0] == v1[0] && v3[1] == v1[1] && v3[2] == v1[2] {
+		t.Errorf("offline embedding collided for distinct texts")
+	}
+	// vectors are unit-length (L2 normalized)
+	var norm float64
+	for _, x := range v1 {
+		norm += float64(x) * float64(x)
+	}
+	if math.Abs(math.Sqrt(norm)-1) > 1e-4 {
+		t.Errorf("offline vector not unit-length: norm=%f", math.Sqrt(norm))
+	}
+}
diff --git a/services/mddbd/internal/embedding/embedding_offline.go b/services/mddbd/internal/embedding/embedding_offline.go
new file mode 100644
index 0000000..2e27a75
--- /dev/null
+++ b/services/mddbd/internal/embedding/embedding_offline.go
@@ -0,0 +1,92 @@
+package embedding
+
+import (
+	"context"
+	"hash/fnv"
+	"math"
+)
+
+// OfflineProvider is a deterministic, network-free embedding provider intended
+// for CI and offline runs. It derives a stable vector from a hash of the text so
+// the vector index and semantic-search endpoints function without an external
+// model or GPU. Vectors are reproducible across runs but semantically neutral
+// (they do not capture meaning); they exist to exercise the full
+// embed -> index -> search pipeline on machines without a real embedder.
+type OfflineProvider struct {
+	model      string
+	dimensions int
+}
+
+// NewOfflineProvider creates a deterministic offline embedding provider.
+// An empty model defaults to "offline-hash-v1"; a non-positive dimensions
+// defaults to 256.
+func NewOfflineProvider(model string, dimensions int) *OfflineProvider {
+	if model == "" {
+		model = "offline-hash-v1"
+	}
+	if dimensions <= 0 {
+		dimensions = 256
+	}
+	return &OfflineProvider{model: model, dimensions: dimensions}
+}
+
+// Model returns the model name used by this provider.
+func (p *OfflineProvider) Model() string { return p.model }
+
+// Dimensions returns the embedding dimensionality.
+func (p *OfflineProvider) Dimensions() int { return p.dimensions }
+
+// embed deterministically maps text to a unit-length vector of p.dimensions.
+// Each component is an independent FNV-1a hash of (seed, dimension index),
+// mapped to [-1, 1] and finally L2-normalized, so identical text always yields
+// the identical vector.
+func (p *OfflineProvider) embed(text string) []float32 {
+	d := p.dimensions
+	vec := make([]float32, d)
+
+	base := fnv.New64a()
+	_, _ = base.Write([]byte(text))
+	seed := base.Sum64()
+
+	var buf [16]byte
+	for j := 0; j < 8; j++ {
+		buf[j] = byte(seed >> (8 * uint(j)))
+	}
+
+	for i := 0; i < d; i++ {
+		for j := 0; j < 8; j++ {
+			buf[8+j] = byte(uint64(i) >> (8 * uint(j)))
+		}
+		h := fnv.New64a()
+		_, _ = h.Write(buf[:])
+		v := float64(int64(h.Sum64())) / float64(math.MaxInt64) // [-1, 1]
+		vec[i] = float32(v)
+	}
+
+	// L2 normalize
+	var norm float64
+	for i := 0; i < d; i++ {
+		norm += float64(vec[i]) * float64(vec[i])
+	}
+	norm = math.Sqrt(norm)
+	if norm > 0 {
+		for i := 0; i < d; i++ {
+			vec[i] = float32(float64(vec[i]) / norm)
+		}
+	}
+	return vec
+}
+
+// Embed generates a deterministic embedding for a single text.
+func (p *OfflineProvider) Embed(ctx context.Context, text string) ([]float32, error) {
+	return p.embed(text), nil
+}
+
+// EmbedBatch generates deterministic embeddings for multiple texts.
+func (p *OfflineProvider) EmbedBatch(ctx context.Context, texts []string) ([][]float32, error) {
+	out := make([][]float32, len(texts))
+	for i, t := range texts {
+		out[i] = p.embed(t)
+	}
+	return out, nil
+}
