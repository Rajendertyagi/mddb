+// supportsFlush reports whether the response writer chain can flush, walking
+// through any middleware wrappers (metrics statusRecorder, MCP statusWriter,
+// etc.) via Unwrap. This lets SSE work even when w is wrapped by a writer that
+// does not implement http.Flusher directly — the BUG-11 root-cause guard.
+func supportsFlush(w http.ResponseWriter) bool {
+	for {
+		if _, ok := w.(http.Flusher); ok {
+			return true
+		}
+		u, ok := w.(interface{ Unwrap() http.ResponseWriter })
+		if !ok {
+			return false
+		}
+		w = u.Unwrap()
+		if w == nil {
+			return false
 		}
 	}
 }
