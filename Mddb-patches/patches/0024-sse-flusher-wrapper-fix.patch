+// Flush forwards to the embedded ResponseWriter so middleware that wraps w
+// (for example, SSE / streaming handlers) still observes a flushable writer.
+// BUG-11 root cause: without this, w.(http.Flusher) failed and /v1/events
+// returned 500 "streaming not supported" whenever metrics were enabled (the
+// metrics middleware wraps w in a statusRecorder).
+func (r *statusRecorder) Flush() {
+	if f, ok := r.ResponseWriter.(http.Flusher); ok {
+		f.Flush()
