+// nonFlusherWrap simulates production middleware (e.g. the metrics
+// statusRecorder) that wraps http.ResponseWriter in a type which embeds the
+// underlying writer but does NOT itself declare http.Flusher. Before the
+// BUG-11 fix, handleSSE's raw w.(http.Flusher) assertion failed against such a
+// wrapper and returned 500 "streaming not supported".
+type nonFlusherWrap struct {
+	http.ResponseWriter
+}
+
+// TestSSEHandleThroughNonFlusherWrapper is the BUG-11 regression test: /v1/events
+// must stream successfully even when the response writer is wrapped by a
+// middleware that does not re-export http.Flusher. It asserts the connection
+// succeeds (200), Content-Type is text/event-stream, and the initial "connected"
+// event is actually delivered.
+func TestSSEHandleThroughNonFlusherWrapper(t *testing.T) {
+	s := &Server{SSEHub: NewSSEHub(true, 100, 5)}
+
+	ts := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		s.handleSSE(&nonFlusherWrap{ResponseWriter: w}, r)
+	}))
+	defer ts.Close()
+
+	resp, err := http.Get(ts.URL)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer func() { _ = resp.Body.Close() }()
+
+	if resp.StatusCode != http.StatusOK {
+		t.Fatalf("BUG-11: expected 200, got %d (SSE returned 'streaming not supported')", resp.StatusCode)
+	}
+	if ct := resp.Header.Get("Content-Type"); ct != "text/event-stream" {
+		t.Errorf("expected Content-Type text/event-stream, got %q", ct)
+	}
+
+	// The initial "connected" event must be delivered (proves streaming works
+	// through the wrapper, not just that the handler returned 200).
+	ch := make(chan string, 1)
+	go func() {
+		sc := bufio.NewScanner(resp.Body)
+		if sc.Scan() {
+			ch <- sc.Text()
+		}
+		close(ch)
+	}()
+	select {
+	case line := <-ch:
+		if !strings.Contains(line, "event: connected") {
+			t.Errorf("expected 'event: connected' in first SSE frame, got %q", line)
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("timeout: no SSE data delivered through wrapper (BUG-11 regression)")
+	}
+}
